# Tiles generados (regenerar con `pnpm tiles`) y temporales del tiler
public/assets/maps/tiles
.tmp-tiles

# Mapas originales PNG — referencia local del generador (no se despliegan;
# en public/ quedan solo los 3 de runtime). Para versionarlos usar Git LFS.
public/assets/maps/cap1/*
public/assets/maps/cap2/*
public/assets/maps/cap3/*
public/assets/maps/cap4/*
public/assets/maps/intro/*
# Excepciones: assets de runtime (van al deploy y a git). Con `carpeta/*` sí
# funcionan: git no puede re-incluir archivos de una carpeta excluida entera.
!public/assets/maps/cap1/encuadres-high.webp
!public/assets/maps/cap1/encuadres-mid.webp
!public/assets/maps/cap1/encuadres-low.webp
!public/assets/maps/cap1/formas-del-paisaje.png
!public/assets/maps/cap2/modelo-territorial-suarez.png
!public/assets/maps/cap2/sintesisCali.webp
assets-raw/

